<section
	id="contacto"
	class="bg-slate-100 py-24 transition-colors dark:bg-slate-900"
>
	<div class="mx-auto max-w-7xl px-6">

		<div
			class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-xl shadow-slate-300/30 transition-colors dark:border-slate-800 dark:bg-slate-950 dark:shadow-none"
		>
			<div class="grid lg:grid-cols-2">

				<!-- Información -->
				<div
					class="bg-linear-to-br from-slate-200 via-slate-100 to-blue-100/70 p-8 sm:p-12 lg:p-14 dark:from-slate-950 dark:via-slate-900 dark:to-slate-900"
				>
					<p
						class="text-sm font-semibold uppercase tracking-widest text-blue-600 dark:text-blue-400"
					>
						Hablemos
					</p>

					<h2
						class="mt-4 max-w-lg text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100"
					>
						¿Tienes una idea para tu negocio?
					</h2>

					<p
						class="mt-6 max-w-lg text-lg leading-8 text-slate-600 dark:text-slate-300"
					>
						Cuéntanos qué necesitas y conversemos sobre una solución digital
						clara, moderna y pensada para tu negocio.
					</p>

					<div class="mt-10 space-y-6">

						<div class="flex items-start gap-4">
							<div
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-xl dark:bg-blue-950"
							>
								💬
							</div>

							<div>
								<h3 class="font-semibold text-slate-900 dark:text-slate-100">
									Contacto directo
								</h3>

								<p class="mt-1 text-slate-600 dark:text-slate-400">
									Podremos integrar WhatsApp para facilitar el contacto con
									potenciales clientes.
								</p>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-xl dark:bg-blue-950"
							>
								✉️
							</div>

							<div>
								<h3 class="font-semibold text-slate-900 dark:text-slate-100">
									Correo electrónico
								</h3>

								<p class="mt-1 text-slate-600 dark:text-slate-400">
									Las consultas también podrán enviarse directamente al correo
									del negocio.
								</p>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-xl dark:bg-blue-950"
							>
								⚡
							</div>

							<div>
								<h3 class="font-semibold text-slate-900 dark:text-slate-100">
									Respuesta simple
								</h3>

								<p class="mt-1 text-slate-600 dark:text-slate-400">
									El objetivo es reducir pasos y hacer que contactar al negocio
									sea lo más sencillo posible.
								</p>
							</div>
						</div>

					</div>
				</div>

				<!-- Formulario -->
				<div class="p-8 sm:p-12 lg:p-14">

					<form class="space-y-6">

						<div>
							<label
								for="nombre"
								class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200"
							>
								Nombre
							</label>

							<input
								id="nombre"
								type="text"
								placeholder="Tu nombre"
								class="w-full rounded-xl border border-slate-300 bg-slate-100 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
							/>
						</div>

						<div>
							<label
								for="email"
								class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200"
							>
								Correo
							</label>

							<input
								id="email"
								type="email"
								placeholder="nombre@empresa.cl"
								class="w-full rounded-xl border border-slate-300 bg-slate-100 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
							/>
						</div>

						<div>
							<label
								for="mensaje"
								class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200"
							>
								¿Cómo podemos ayudarte?
							</label>

							<textarea
								id="mensaje"
								rows="5"
								placeholder="Cuéntanos brevemente qué necesita tu negocio..."
								class="w-full resize-none rounded-xl border border-slate-300 bg-slate-100 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
							></textarea>
						</div>

						<button
							type="button"
							class="w-full rounded-xl bg-blue-600 px-6 py-3.5 font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/20"
						>
							Enviar consulta
						</button>

						<p class="text-center text-sm text-slate-500 dark:text-slate-400">
							Formulario demostrativo. La integración de envío se agregará posteriormente.
						</p>

					</form>

				</div>

			</div>
		</div>

	</div>
</section>