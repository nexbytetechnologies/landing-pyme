---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  class="fixed top-0 z-50 w-full border-b border-slate-200/80 bg-slate-100/95 backdrop-blur-md transition-colors dark:border-slate-800 dark:bg-slate-950/90"
>
  <nav class="mx-auto max-w-7xl px-6">
    <div class="flex items-center justify-between py-4">
      <a href={import.meta.env.BASE_URL} class="flex items-center gap-2">
        <img
          src={`${import.meta.env.BASE_URL}/nexopyme-icon.png`}
          alt=""
          class="h-9 w-9"
        />

        <span
          class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100"
        >
          Nexo<span class="text-blue-600 dark:text-blue-400">Pyme</span>
        </span>
      </a>

      <div class="hidden items-center gap-8 md:flex">
        <a
          href="#inicio"
          class="text-sm font-medium text-slate-600 transition hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400"
        >
          Inicio
        </a>

        <a
          href="#servicios"
          class="text-sm font-medium text-slate-600 transition hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400"
        >
          Servicios
        </a>

        <a
          href="#nosotros"
          class="text-sm font-medium text-slate-600 transition hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400"
        >
          Nosotros
        </a>

        <a
          href="#contacto"
          class="text-sm font-medium text-slate-600 transition hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400"
        >
          Contacto
        </a>
      </div>

      <div class="flex items-center gap-2">
        <ThemeToggle />

        <a
          href="#contacto"
          class="hidden rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 md:block"
        >
          Cotizar
        </a>

        <button
          id="menu-toggle"
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-xl text-xl text-slate-700 transition hover:bg-slate-200 dark:text-slate-200 dark:hover:bg-slate-800 md:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          ☰
        </button>
      </div>
    </div>

    <!-- Menú móvil -->
    <div
      id="mobile-menu"
      class="hidden border-t border-slate-200 pb-5 pt-4 dark:border-slate-800 md:hidden"
    >
      <div class="flex flex-col gap-2">
        <a
          href="#inicio"
          class="mobile-link rounded-lg px-3 py-3 font-medium text-slate-700 transition hover:bg-slate-200 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          Inicio
        </a>

        <a
          href="#servicios"
          class="mobile-link rounded-lg px-3 py-3 font-medium text-slate-700 transition hover:bg-slate-200 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          Servicios
        </a>

        <a
          href="#nosotros"
          class="mobile-link rounded-lg px-3 py-3 font-medium text-slate-700 transition hover:bg-slate-200 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          Nosotros
        </a>

        <a
          href="#contacto"
          class="mobile-link rounded-lg px-3 py-3 font-medium text-slate-700 transition hover:bg-slate-200 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          Contacto
        </a>

        <a
          href="#contacto"
          class="mobile-link mt-2 rounded-xl bg-blue-600 px-4 py-3 text-center font-semibold text-white transition hover:bg-blue-700"
        >
          Solicitar cotización
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector("#menu-toggle");
  const mobileMenu = document.querySelector("#mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  function closeMenu() {
    mobileMenu?.classList.add("hidden");
    menuButton?.setAttribute("aria-expanded", "false");

    if (menuButton) {
      menuButton.textContent = "☰";
    }
  }

  menuButton?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.toggle("hidden");

    menuButton.setAttribute("aria-expanded", isHidden ? "false" : "true");

    menuButton.textContent = isHidden ? "☰" : "✕";
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
