---
import '../styles/global.css';
---
<!doctype html>

<html lang="es">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<meta
			name="description"
			content="Soluciones digitales modernas para pequeñas y medianas empresas."
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<title>Landing Pyme | Soluciones para tu negocio</title>
	</head>

	<body>
		<slot />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
	}

	button,
	input,
	textarea {
		font: inherit;
	}

	img {
		max-width: 100%;
		display: block;
	}
</style>
